{
  "manifest_version": 3,
  "name": "Battrack — conso des onglets",
  "version": "1.1",
  "description": "CPU et RAM par onglet (lit /proc via battrack). Sur batterie, endort les onglets en arrière-plan qui mangent du CPU.",
  "key": "",
  "permissions": ["tabs", "webNavigation", "nativeMessaging", "favicon", "alarms", "storage"],
  "background": { "service_worker": "auto.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conso des onglets",
    "default_icon": { "16": "icon16.png", "32": "icon32.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
